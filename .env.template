GROQ_API_KEY=your_api_key_here

# ── Twitter / X Scraper ───────────────────────────────────────────────────────
# Export your Twitter/X session cookies as a JSON array using a browser extension
# such as "Cookie-Editor" or "EditThisCookie", then paste the full JSON here.
# Required cookie names: auth_token, ct0  (others can be included for safety)
# Example format:
#   TWITTER_COOKIES=[{"name":"auth_token","value":"…","domain":".twitter.com","path":"/","secure":true,"httpOnly":true},{"name":"ct0","value":"…","domain":".twitter.com","path":"/","secure":true}]
TWITTER_COOKIES=your_exported_cookie_json_array_here

# ── Quora Scraper ──────────────────────────────────────────────────────────────
# Export your Quora session cookies as a JSON array using a browser extension.
# Example format:
#   QUORA_COOKIES=[{"name":"m-b_jazoest","value":"…","domain":".quora.com",...}]
QUORA_COOKIES=your_exported_quora_cookie_json_array_here
